<p style="color: green"><%= notice %></p>

<% content_for :title, "Clients" %>

<h1>Clientes</h1>

<div id="clients">
  <% @clients.each do |client| %>
    <%= render client %>
    <p>
      <%= link_to "Visualizar cliente", client, class: "link-form" %>
    </p>
  <% end %>
</div>

<%= link_to "Cadastrar novo cliente", new_client_path, class: "link-form" %>
