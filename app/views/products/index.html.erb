<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>

<h1>Produtos</h1>

<div id="products">
  <% @products.each do |product| %>
    <%= render product %>
    <p>
      <%= link_to "Visualizar produto", product, class: "link-form" %>
    </p>
  <% end %>
</div>

<%= link_to "Novo produto", new_product_path, class: "link-form" %>
